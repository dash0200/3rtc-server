{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "ws"]
  },
  "include": [
    "*.js",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "tests"
  ]
}
